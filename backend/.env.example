# Database Configuration
# Default to SQLite for seamless zero-setup local execution; use PostgreSQL for production:
# DATABASE_URL=postgresql://user:password@localhost:5432/careerpilot
DATABASE_URL=sqlite:///./careerpilot.db

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_careerpilot_ai_change_in_production_987654321
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Settings
# LLM_PROVIDER options: "gemini", "openai", "demo"
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004

# Demo Mode (auto-fallback if no API keys provided)
DEMO_MODE=true

# Storage
UPLOAD_DIR=./uploads
